# Copy this file to `.env` and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API (or "API Keys").
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (older projects call it the "anon public" key).
# Never put the "secret" / "service_role" key here.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
